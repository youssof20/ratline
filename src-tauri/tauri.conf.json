{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ratline",
  "version": "0.2.2",
  "identifier": "app.ratline.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ratline",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
